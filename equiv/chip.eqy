# Netlist-to-RTL equivalence of the chip (C3 WP9): the RTL of a commit (gold) against the final netlist of that
# commit's layout run (gate), with eqy. .github/workflows/equiv.yaml fills in the paths (@...@) and runs it.
# Gold: the info.yaml sources with SYNTHESIS defined, so src/pe_cells.v instantiates the latch and clock-gate cells
# as the flow does. Gate: the netlist with the standard cells read from the PDK liberty (their functions); the latch
# and clock-gate cells (equiv/cells_bb.v) and the SRAM macros (src/sram_bb.v) are the same black boxes on both
# sides, matched by instance path, so their input signals are compared. Filler, tap, decap and antenna cells carry no
# logic.

[gold]
read_verilog -lib @ROOT@/equiv/cells_bb.v @RTL@/src/sram_bb.v
read_verilog -sv -DSYNTHESIS @RTL_FILES@
prep -top tt_um_soundgod10_droid_protocol_emulator
flatten
memory_map
opt_clean

[gate]
read_verilog -lib @ROOT@/equiv/cells_bb.v @RTL@/src/sram_bb.v
read_liberty -ignore_redef -ignore_miss_func @LIB@
read_verilog @NL@
prep -top tt_um_soundgod10_droid_protocol_emulator
flatten
# Every name that can match the RTL is inside one of its instances (u_*) or a port. Flattening names the cells'
# pin wires after the cells (_19785_.A0 beside u_proc...u_lat.q) and the layout adds nets (net5288, clknet_*,
# clknet_..._<design net>): eqy read them as second matches for the same gold bit (equiv runs 44773718663,
# 44802852152). All of them are made private; ports keep their names (rename -hide skips ports). With the buffers'
# function X = A each net then keeps only its synthesis name.
rename -hide w:* w:u_* %d
opt_clean

[match *]
# The clock port wires of the instances: only the chip's clock pin is matched.
gold-nomatch *.clk
gate-nomatch *.clk
# The latch enables (gated clocks of the latch memories): the clock tree splits each word's gated clock into several
# buffered nets that keep the RTL names of different bits, while the RTL has one net per word, so one gold net got
# two gate names in one partition (run 44830886025: word 9, g_bit[0] and g_bit[10], "used but has no driver").
gold-nomatch /.+\.u_lat\.g/
gate-nomatch /.+\.u_lat\.g/

# k-induction on every piece (a base case from the initial state and an induction step), then PDR for the pieces
# that k-induction leaves open (PDR finds the invariant that relates two encodings of the same state).
[strategy ind]
use sby
depth 3
engine smtbmc yices

[strategy pdr]
use sby
engine abc pdr
timeout 2400

# Guard mode of the equivalence check: the RTL of one commit (gold) against the RTL of another (gate), both read as
# the netlist check reads the gold side (SYNTHESIS defined, the latch and clock-gate cells and the SRAM macros as
# matched black boxes). .github/workflows/equiv.yaml (job guard) fills in the paths (@...@).

[gold]
read_verilog -lib @ROOT@/equiv/cells_bb.v @GOLD@/src/sram_bb.v
read_verilog -sv -DSYNTHESIS @GOLD_FILES@
prep -top tt_um_soundgod10_droid_protocol_emulator
flatten
memory_map
opt_clean
# the black-box clock pins that clk drives with no logic, as in equiv/chip.eqy (equiv/clk_tie.v)
techmap -map @ROOT@/equiv/clk_tie.v t:sg13cmos5l_lgcp_1
cd tt_um_soundgod10_droid_protocol_emulator
connect -port u_proc.u_mem.u_pmem A_CLK 1'0
connect -port u_proc.u_mem.u_dmem A_CLK 1'0
cd ..
opt_clean

[gate]
read_verilog -lib @ROOT@/equiv/cells_bb.v @GATE@/src/sram_bb.v
read_verilog -sv -DSYNTHESIS @GATE_FILES@
prep -top tt_um_soundgod10_droid_protocol_emulator
flatten
memory_map
opt_clean
techmap -map @ROOT@/equiv/clk_tie.v t:sg13cmos5l_lgcp_1
cd tt_um_soundgod10_droid_protocol_emulator
connect -port u_proc.u_mem.u_pmem A_CLK 1'0
connect -port u_proc.u_mem.u_dmem A_CLK 1'0
cd ..
opt_clean

[strategy sby]
use sby
depth 10
engine smtbmc yices

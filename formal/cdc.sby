# cdc: structural clock-domain-crossing and reset check of the whole chip (docs/signoff.md section 2).
#
# The design is flattened and mapped to single-bit cells, and every net is split to single bits.
# Each "select -assert-count" line is one check; the job stops with an error at the first that fails.
#   C1 The 16 asynchronous data inputs (ui_in, uio_in) reach storage only at 16 flip-flops with an
#      asynchronous reset, the first stages of pe_sync2 synchronizers (net names *_sync.stage[0]).
#   C2 Between a pin and its first stage there are 17 logic cells: the inverter of HOST_CS_N and the
#      two cells of the pin multiplexer (uio_in & ~OE | V & OE) of each of the 8 uio inputs.
#   C3 Each first stage drives only one cell, its second stage (net names *_sync.stage[1]): no logic
#      reads a first stage.
#   R1 rst_n reaches only the 2 flip-flops of the reset synchronizer.
#   R2 The asynchronous reset pins are driven by 3 nets only: rst_n (reset synchronizer), its output
#      (u_reset_sync.stage[1]) and the processor reset run_rst_n.
# A synchronizer bypass (q = stage[1] | d) fails C1 (504 storage cells reached), a one-stage
# synchronizer (q = stage[0]) fails C3 (6,785 cells reached). The bmc at the end only lets the job
# finish; it has no property.

[options]
mode bmc
depth 1

[engines]
smtbmc z3

[script]
read -formal pe_cells.v pe_config.v pe_core.v pe_cycle_counter.v pe_host_fifo.v pe_host_port.v
read -formal pe_latch_ram.v pe_proc.v pe_sync.v pe_timed_in.v pe_timed_out.v project.v
prep -top tt_um_soundgod10_droid_protocol_emulator
flatten
opt_clean
techmap
opt_clean
splitnets -ports
select -set ain i:* w:clk w:rst_n w:ena %u %u %d
select -assert-count 16 @ain
select -set cone1 @ain %co*:-[Q]
select -set st1 @cone1 t:$_DFF* t:$_DLATCH* %u %i
select -assert-count 16 @st1
select -assert-count 16 @st1 t:$_DFF_PN0_ %i
select -set q1 @st1 %co1:+[Q] w:* %i
select -assert-count 16 @q1 w:*_sync.stage?0? %i
select -assert-count 17 @cone1 c:* %i @st1 %d
select -set cone2 @q1 %co*:-[Q]
select -assert-count 16 @cone2 c:* %i
select -assert-count 16 @cone2 c:* %i %co1:+[Q] w:*_sync.stage?1? %i
select -assert-count 2 w:rst_n %co*:-[Q] c:* %i
select -assert-count 2 w:rst_n %co*:-[Q] c:* %i %co1:+[Q] w:u_reset_sync.stage?*? %i
select -assert-count 3 t:$_DFF_PN* t:$_DFF_PP* t:$_DFFE_PN* t:$_DFFE_PP* %u %u %u %ci1:+[R] w:* %i
design -reset
read -formal pe_sync.v
prep -top pe_sync2

[files]
../src/pe_cells.v
../src/pe_config.v
../src/pe_core.v
../src/pe_cycle_counter.v
../src/pe_host_fifo.v
../src/pe_host_port.v
../src/pe_latch_ram.v
../src/pe_proc.v
../src/pe_sync.v
../src/pe_timed_in.v
../src/pe_timed_out.v
../src/project.v

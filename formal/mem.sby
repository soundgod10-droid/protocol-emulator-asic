# M2b: bounded check of the latch memory properties (pe_latch_ram `ifdef
# FORMAL: M1 to M4) at the chip size 128 x 16 with the harness mem_fv.v.
# multiclock: the clock is a signal that changes at each solver step, and
# the latches are level-sensitive elements, not flip-flops.
# Bounded, not a proof: k-induction of the 2,048 latches gave no result
# in 30 minutes. The proof for all time is mem_small.sby (8 x 16, same
# generated logic for each word, free word address). This job checks
# that the chip-size address decoder and the 128:1 read port agree.
# 8 steps = 4 clock cycles: a write request, the write, an overwrite and
# reads in each half cycle.

[options]
mode prove
depth 8
multiclock on

[engines]
smtbmc z3

[script]
read -formal pe_cells.v pe_latch_ram.v mem_fv.v
prep -top mem_fv
# The job stops with an error if Yosys removed properties (5 asserts are
# written in pe_latch_ram).
select -assert-min 5 t:$check t:$assert

[files]
../src/pe_cells.v
../src/pe_latch_ram.v
mem_fv.v

# M2b: k-induction proof of the latch memory properties (pe_latch_ram
# `ifdef FORMAL: M1 to M4) with all 128 words of the chip and a 2-bit
# word (mem_fv.v WIDTH = 2), so that the full address decoder, the 128
# clock gates and the 128:1 read port are checked. mem_small.sby checks
# the full 16-bit word width with 8 words. Z3 did not finish the 128 x 16
# instance (proof: no result in 30 minutes; 4-cycle BMC: no result in 25
# minutes). multiclock: the clock is a signal that changes at each solver
# step, and the latches are level-sensitive elements, not flip-flops.

[options]
mode prove
depth 8
multiclock on

[engines]
smtbmc z3

[script]
read -formal pe_cells.v pe_latch_ram.v mem_fv.v
chparam -set WIDTH 2 mem_fv
prep -top mem_fv
# The job stops with an error if Yosys removed properties (5 asserts are
# written in pe_latch_ram).
select -assert-min 5 t:$check t:$assert

[files]
../src/pe_cells.v
../src/pe_latch_ram.v
mem_fv.v

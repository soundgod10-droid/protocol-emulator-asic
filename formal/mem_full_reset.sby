# mem_full_reset: proof of the latch memory at the chip size, 128 words x 16 bits,
# with a free reset (mem_fv.v FREE_RESET = 1).
#
# What it does:
#   mem_full.sby with the reset free at each solver step. The choice of
#   docs/decisions.md entry 7 (no reset on the memory write-data
#   flip-flops) was checked with a free reset
#   only at 8 x 16 by bmc (mem_reset.sby); this job proves M1 to M4 of
#   pe_latch_ram at the chip size for all time.
#
# Why depth 3:
#   As mem_full.sby: the smallest depth that holds the 2 induction steps.
#
# Expected result: PASS ("successful proof by k-induction"), about 10 minutes
# with Z3 (586 s on the research branch r3-mem-reset-full, 3d6dbc1).

[options]
mode prove
depth 3
multiclock on

[engines]
smtbmc z3

[script]
read -formal pe_cells.v pe_latch_ram.v mem_fv.v
chparam -set FREE_RESET 1 mem_fv
prep -top mem_fv

[files]
../src/pe_cells.v
../src/pe_latch_ram.v
mem_fv.v

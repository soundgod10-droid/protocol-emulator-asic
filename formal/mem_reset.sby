# M2b: bounded check of the latch memory (8 x 16) with a free reset
# (mem_fv.v FREE_RESET = 1). Expected result: PASS (10 steps).
# In M2b it failed M2/M3: a reset in the first half of the cycle after a
# store set the write data flip-flop to 0 while the word was open, so the
# word got 0 and not the stored data. M2c removed the reset of the write
# data flip-flops (decision D6), and the check now passes. The proof at the
# chip size, 128 x 16, for all time is mem_full_reset.sby.

[options]
mode bmc
depth 10
multiclock on

[engines]
smtbmc z3

[script]
read -formal pe_cells.v pe_latch_ram.v mem_fv.v
chparam -set WORDS 8 -set AW 3 -set FREE_RESET 1 mem_fv
prep -top mem_fv

[files]
../src/pe_cells.v
../src/pe_latch_ram.v
mem_fv.v

# slu_eth: the 10BASE-Te helper copy of the chip (pe_slu SPEC 2, FULL 1) against formal/slu_fv.v H1, H2, H5 to
# H8 (CRC-32 sent and checked with the IEEE 802.3 polynomial and residue, Manchester halves on the outputs,
# 6-cycle bit period with the mid-bit change after 3 cycles, 32 jam bits after a collision, frame start at
# TXTIME), H9 (unjab 65,536 ticks after the jabber onset) and H10 (jabber only after 8,192 ticks of unbroken
# transmit time), every port access and pin input free. The monitor wires are connected to internal nets after
# flattening, so the RTL stays unchanged.

[options]
mode prove
depth 4

[engines]
smtbmc z3

[script]
read -formal -DSLU_JABBER pe_slu_loop.v pe_slu.v slu_fv.v
hierarchy -top slu_fv -chparam SPEC 2
prep -top slu_fv
flatten
cd slu_fv
script slu_connect.ys
connect -set mon_cmode \u_slu.c_mode
connect -set mon_ctxper \u_slu.c_txper
connect -set mon_ccrcw \u_slu.c_crcw
connect -set mon_cpa \u_slu.c_pa
connect -set mon_jabber \u_slu.jabber
connect -set mon_jabcnt \u_slu.jab_cnt
opt_clean
cd ..
# The job stops with an error if a property was removed: 30 asserts of slu_fv.v for SPEC 2 (with H9 and H10)
# and its 2 assumes.
select -assert-min 32 t:$check t:$assert t:$assume

[files]
../src/pe_slu_loop.v
../src/pe_slu.v
slu_fv.v
slu_connect.ys

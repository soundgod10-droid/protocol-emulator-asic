# slu_eth: the 10BASE-Te helper copy of the chip (pe_slu SPEC 2, FULL 1) against formal/slu_fv.v H1, H2, H5 to
# H8 (CRC-32 sent and checked with the IEEE 802.3 polynomial and residue, Manchester halves on the outputs,
# 6-cycle bit period with the mid-bit change after 3 cycles, 32 jam bits after a collision, frame start at
# TXTIME), every port access and pin input free. The monitor wires are connected to internal nets after
# flattening, so the RTL stays unchanged.

[options]
mode prove
depth 4

[engines]
smtbmc z3

[script]
read -formal pe_slu_loop.v pe_slu.v slu_fv.v
hierarchy -top slu_fv -chparam SPEC 2
prep -top slu_fv
flatten
cd slu_fv
script slu_connect.ys
connect -set mon_cmode \u_slu.c_mode
connect -set mon_ctxper \u_slu.c_txper
connect -set mon_ccrcw \u_slu.c_crcw
connect -set mon_cpa \u_slu.c_pa
opt_clean
cd ..
# The job stops with an error if a property was removed: 28 asserts of slu_fv.v for SPEC 2 and its assume.
select -assert-min 29 t:$check t:$assert t:$assume

[files]
../src/pe_slu_loop.v
../src/pe_slu.v
slu_fv.v
slu_connect.ys

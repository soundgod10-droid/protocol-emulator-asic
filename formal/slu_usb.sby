# slu_usb: the USB low-speed helper copy of the chip (pe_slu SPEC 1, FULL 0) against formal/slu_fv.v H1 to H4,
# H6, H8 (CRC16 and CRC5 sent and checked with the USB 2.0 polynomials and residues, bit stuffing, NRZI on
# the outputs, 40-cycle bit period, frame start at TXTIME), every port access and pin input free. The monitor
# wires are connected to internal nets after flattening, so the RTL stays unchanged.

[options]
mode prove
depth 4

[engines]
smtbmc z3

[script]
read -formal pe_slu_loop.v pe_slu.v slu_fv.v
hierarchy -top slu_fv -chparam SPEC 1
prep -top slu_fv
flatten
cd slu_fv
script slu_connect.ys
connect -set mon_cmode \u_slu.c_mode
connect -set mon_ctxper \u_slu.c_txper
connect -set mon_ccrcw \u_slu.c_crcw
connect -set mon_cpa \u_slu.c_pa
opt_clean
cd ..
# The job stops with an error if a property was removed: 28 asserts of slu_fv.v for SPEC 1 and its 2 assumes.
select -assert-min 30 t:$check t:$assert t:$assume

[files]
../src/pe_slu_loop.v
../src/pe_slu.v
slu_fv.v
slu_connect.ys

# uart_tx.sby: formal check of the M1 UART transmitter (SymbiYosys, Z3).
#
# Mode: prove (k-induction). It proves P1 to P8 and the invariants I0 to
# I13 and H1 to H6 in uart_tx_fv.v for all time, not only for a number of
# cycles.
# uart_tx_cover.sby shows that a byte is taken and that a frame starts,
# so the properties are not true only because nothing occurs.
#
# Why the script flattens the design and uses "connect -set":
#   The Yosys on this workstation does not read hierarchical names in a
#   property. After "flatten", the internal registers have names such as
#   dut.u_uart_tx_seq.state. "connect -set" connects the f_* wires of
#   uart_tx_fv to them before optimization.
#
# Why "-nounset":
#   Without it, "connect -set" removes all drivers of the left side, and it
#   also removes aliases such as "f_now = f_count[15:0]". Then f_now has no
#   driver and the solver gives it any value. The f_* wires have no driver
#   of their own, so "-nounset" removes nothing that is necessary.
#
# Why "multiclock on":
#   The design has asynchronous resets. With "multiclock on", the solver
#   uses an exact model of the asynchronous reset. Each clock cycle is
#   2 steps, so depth 20 is 10 clock cycles.
#
# The tasks are in two files (uart_tx.sby, uart_tx_cover.sby) because the
# formal runner on this workstation gives no result for a file with
# [tasks].

[options]
mode prove
depth 20
multiclock on

[engines]
smtbmc z3

[script]
read -formal pe_cycle_counter.v
read -formal pe_sync.v
read -formal pe_timed_out.v
read -formal pe_uart_tx_seq.v
read -formal pe_test_port.v
read -formal pe_config.v
read -formal pe_proc.v
read -formal project.v
read -formal uart_tx_fv.v
# M2b: in M1 mode (CORE_SEL = 0, assumed in uart_tx_fv.v) the processor
# and its configuration drive no M1 pin, so they are black boxes with free
# outputs. Their 2,560 latches would make the proof too large.
blackbox pe_proc pe_config
hierarchy -top uart_tx_fv
proc
flatten
cd uart_tx_fv
connect -nounset -set f_rst_i  dut.rst_n_int
connect -nounset -set f_rsync  dut.u_reset_sync.stage
connect -nounset -set f_count  dut.cycle_count
connect -nounset -set f_take   dut.u_uart_tx_seq.take
connect -nounset -set f_state  dut.u_uart_tx_seq.state
connect -nounset -set f_frame  dut.u_uart_tx_seq.frame
connect -nounset -set f_nbits  dut.u_uart_tx_seq.nbits
connect -nounset -set f_tnext  dut.u_uart_tx_seq.t_next
connect -nounset -set f_v      dut.u_tx_channel.ev_valid
connect -nounset -set f_te     dut.u_tx_channel.ev_time_q
connect -nounset -set f_ve     dut.u_tx_channel.ev_value_q
connect -nounset -set f_eoe    dut.u_tx_channel.ev_oe_q
connect -nounset -set f_pin_oe dut.u_tx_channel.pin_oe
connect -nounset -set f_rq     dut.u_tx_req_sync.stage
connect -nounset -set f_csel   dut.u_core_sel_sync.stage
connect -nounset -set f_tp_start dut.tp_start
cd ..
prep -top uart_tx_fv

[files]
../src/pe_cycle_counter.v
../src/pe_sync.v
../src/pe_timed_out.v
../src/pe_uart_tx_seq.v
../src/pe_test_port.v
../src/pe_config.v
../src/pe_proc.v
../src/project.v
uart_tx_fv.v

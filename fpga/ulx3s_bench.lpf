# Bench pin map of the ULX3S (ECP5 12F or 85F, CABGA381) for fpga_top.v and wiring_check.v (docs/bench.md section 2).
# Sites from the board's published constraint file (emard/ulx3s, doc/constraints/ulx3s_v20.lpf): clk is the board's
# 25 MHz oscillator; the chip pins sit on header pins gp/gn 0-10 and 18-19. gp/gn 11-13 are left free: the board's
# WiFi module shares them.
LOCATE COMP "clk" SITE "G2";
IOBUF PORT "clk" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

# ui[0..7] on gp[0..7]
LOCATE COMP "ui[0]" SITE "B11";
LOCATE COMP "ui[1]" SITE "A10";
LOCATE COMP "ui[2]" SITE "A9";
LOCATE COMP "ui[3]" SITE "B9";
LOCATE COMP "ui[4]" SITE "A7";
LOCATE COMP "ui[5]" SITE "C8";
LOCATE COMP "ui[6]" SITE "C6";
LOCATE COMP "ui[7]" SITE "A6";
# uo[0..7] on gn[0..7]
LOCATE COMP "uo[0]" SITE "C11";
LOCATE COMP "uo[1]" SITE "A11";
LOCATE COMP "uo[2]" SITE "B10";
LOCATE COMP "uo[3]" SITE "C10";
LOCATE COMP "uo[4]" SITE "A8";
LOCATE COMP "uo[5]" SITE "B8";
LOCATE COMP "uo[6]" SITE "C7";
LOCATE COMP "uo[7]" SITE "B6";
# uio[0..7] on gp[8], gn[8], gp[9], gn[9], gp[10], gn[10], gp[18], gn[18]
LOCATE COMP "uio[0]" SITE "A4";
LOCATE COMP "uio[1]" SITE "A5";
LOCATE COMP "uio[2]" SITE "A2";
LOCATE COMP "uio[3]" SITE "B1";
LOCATE COMP "uio[4]" SITE "C4";
LOCATE COMP "uio[5]" SITE "B4";
LOCATE COMP "uio[6]" SITE "H18";
LOCATE COMP "uio[7]" SITE "H17";
# rst_n on gp[19]
LOCATE COMP "rst_n" SITE "F17";

IOBUF PORT "ui[0]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[1]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[2]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[3]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[4]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[5]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[6]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ui[7]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "rst_n" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "uo[0]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[2]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[4]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[5]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[6]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uo[7]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[1]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[2]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[3]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[4]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[5]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[6]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio[7]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
